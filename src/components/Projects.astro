---
import ProjectCard from './ProjectCard.astro';
import Section from './Section.astro';
import { moreProjects, projects } from '../data/projects';
---

<Section id="projects" index="02" label="Projects" title="Selected projects">
  <div class="grid gap-4 md:grid-cols-2">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>

  <h3 class="eyebrow mt-12">Also built</h3>
  <ul class="mt-4 grid gap-4 md:grid-cols-3">
    {
      moreProjects.map((p) => (
        <li class="card p-5" data-reveal>
          <h4 class="text-[15px] font-semibold tracking-tight">{p.name}</h4>
          <p class="mt-1.5 text-sm leading-relaxed text-pretty text-muted">{p.description}</p>
          <p class="mt-3 font-mono text-[11px] text-subtle">{p.stack.join(' · ')}</p>
        </li>
      ))
    }
  </ul>
</Section>
