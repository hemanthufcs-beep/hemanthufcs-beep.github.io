---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line py-10">
  <div class="container-page flex flex-col gap-3 text-sm text-subtle sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {site.name}</p>
    <p>
      Built with Astro &amp; Tailwind CSS ·
      <a href="https://github.com/hemanthufcs-beep/hemanthufcs-beep.github.io" target="_blank" rel="noopener noreferrer" class="link text-subtle">Source</a>
    </p>
  </div>
</footer>
