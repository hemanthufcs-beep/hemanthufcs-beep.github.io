---
import Section from './Section.astro';
import { skills } from '../data/skills';
---

<Section id="skills" index="04" label="Skills" title="Skills">
  <dl class="grid gap-x-10 gap-y-4 md:grid-cols-2" data-reveal>
    {
      skills.map((s) => (
        <div>
          <dt class="text-sm font-medium">{s.group}</dt>
          <dd class="mt-1 text-[15px] leading-relaxed text-muted">{s.items.join(', ')}</dd>
        </div>
      ))
    }
  </dl>
</Section>
