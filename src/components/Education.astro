---
import Section from './Section.astro';
import { education } from '../data/experience';
---

<Section id="education" index="05" label="Education" title="Education">
  <ul class="grid gap-4 md:grid-cols-2">
    {
      education.map((e) => (
        <li class="card p-5" data-reveal>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="font-semibold tracking-tight">{e.school}</h3>
            {'period' in e && <p class="font-mono text-xs text-subtle">{e.period}</p>}
          </div>
          <p class="mt-1 text-sm text-muted">
            {e.degree} · <span class="font-medium text-fg">{e.detail}</span>
          </p>
        </li>
      ))
    }
  </ul>
</Section>
