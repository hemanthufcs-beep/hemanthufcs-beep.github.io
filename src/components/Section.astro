---
interface Props {
  id: string;
  index: string;
  label: string;
  title: string;
}

const { id, index, label, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="border-t border-line py-14 sm:py-20">
  <div class="container-page">
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1" data-reveal>
      <p class="eyebrow"><span class="text-accent">{index}</span> / {label}</p>
      <h2 id={`${id}-title`} class="w-full text-2xl font-semibold tracking-tight text-balance sm:text-3xl">{title}</h2>
    </div>
    <div class="mt-8 sm:mt-10">
      <slot />
    </div>
  </div>
</section>
